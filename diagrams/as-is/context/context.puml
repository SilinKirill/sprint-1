@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(user, "Пользователь", "Управляет отоплением и просматривает температуру через веб-интерфейс")

System(smartHome, "Монолитное приложение", "Go-приложение для управления отоплением и мониторинга температуры")

SystemDb(postgres, "PostgreSQL", "Хранение данных пользователей, домов, устройств и температуры")

System_Ext(heating, "Система отопления", "Подключенная система отопления в доме пользователя")

System_Ext(sensor, "Датчик температуры", "Датчик температуры в доме пользователя")

Rel(user, smartHome, "Управление отоплением и просмотр температуры")
Rel(smartHome, postgres, "Чтение и запись данных")
Rel(smartHome, heating, "Отправка команд управления")
Rel(smartHome, sensor, "Получение данных температуры")

@enduml